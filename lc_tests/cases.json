[
  {
    "tool": "list_devices",
    "comment": "the device list always has the CPU",
    "expect": {
      "results": {
        "values": {
          "pytorch": "installed"
        }
      }
    }
  },
  {
    "tool": "check_everything",
    "inputs": {
      "run_benchmark": true,
      "check_internet": false
    },
    "comment": "the whole chain on this machine: a readout, a table, a report file",
    "expect": {
      "max_seconds": 120,
      "results": {
        "readout": {
          "contains": "checks:"
        },
        "details": {
          "columns": [
            "layer",
            "name",
            "status",
            "detail",
            "fix"
          ]
        }
      }
    }
  },
  {
    "tool": "run_on_device",
    "inputs": {
      "device": "cpu",
      "size": 128,
      "repeats": 2
    },
    "comment": "the same test on the CPU",
    "expect": {
      "results": {
        "values": {
          "device": "cpu"
        }
      }
    }
  },
  {
    "tool": "run_on_device",
    "inputs": {
      "device": "cuda:7",
      "size": 128,
      "repeats": 1
    },
    "comment": "a device that is not here is refused with the list of the ones that are",
    "expect": {
      "status": "FAILED",
      "code": "unknown_device",
      "message_contains": "cpu"
    }
  },
  {
    "tool": "make_test_data",
    "inputs": {
      "folder": "fixtures/data",
      "kind": "all",
      "size": 64
    },
    "comment": "every kind of test file",
    "expect": {
      "results": {
        "files": {
          "contains": "three_channels"
        }
      }
    }
  },
  {
    "tool": "stress_big_image",
    "inputs": {
      "megabytes": 4
    },
    "comment": "a large 16-bit image",
    "expect": {
      "results": {
        "big": {
          "dtype": "uint16"
        }
      }
    }
  },
  {
    "tool": "stress_many_points",
    "inputs": {
      "count": 5000
    },
    "comment": "many points",
    "expect": {
      "results": {
        "points": {
          "rows": 5000,
          "columns": [
            "y",
            "x",
            "score"
          ]
        }
      }
    }
  },
  {
    "tool": "stress_slow",
    "inputs": {
      "seconds": 2
    },
    "comment": "a slow run reports progress",
    "expect": {
      "progress_events_min": 1,
      "results": {
        "values": {
          "worked_seconds": {
            "approx": 2.0,
            "tol": 1.0
          }
        }
      }
    }
  },
  {
    "tool": "stress_slow",
    "inputs": {
      "seconds": 30
    },
    "cancel_after_s": 2,
    "comment": "Cancel stops a polite tool",
    "expect": {
      "status": "CANCELED",
      "max_seconds": 20
    }
  },
  {
    "tool": "stress_out_of_memory",
    "comment": "SIMULATED out of memory (nothing is allocated): a readable failure with the code MemoryError, not a crash",
    "expect": {
      "status": "FAILED",
      "code": "MemoryError",
      "message_contains": "SIMULATED"
    }
  },
  {
    "tool": "stress_crash",
    "comment": "the worker ends without a message",
    "expect": {
      "status": "CRASHED"
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {},
    "expect": {
      "max_seconds": 120,
      "results": {
        "summary": {
          "contains": "16"
        },
        "outlines": {
          "features": 16
        },
        "centres": {
          "rows": 16,
          "columns": [
            "y",
            "x",
            "label"
          ]
        },
        "measurements": {
          "rows": 16
        }
      }
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {
      "image": "fixtures/data/demo_blobs.tif",
      "side_note": "hello \u00b5\u2192\u2713"
    },
    "expect": {
      "results": {
        "summary": {
          "contains": "hello \u00b5\u2192\u2713"
        },
        "outlines": {
          "features": 16
        }
      }
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {
      "image": "fixtures/data/demo_blobs.tif",
      "region": "fixtures/data/top_half_region.tif"
    },
    "expect": {
      "results": {
        "summary": {
          "contains": "inside the region"
        },
        "outlines": {
          "features": 11
        },
        "centres": {
          "rows": 11
        }
      }
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {
      "image": "fixtures/data/demo_blobs.tif",
      "look_for": "dark"
    },
    "expect": {
      "results": {
        "outlines": {
          "features": 3
        }
      }
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {
      "threshold": 1.0,
      "min_size_px": 500
    },
    "expect": {
      "status": "FAILED",
      "code": "no_result",
      "message_contains": "No blob found"
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {
      "image": "fixtures/data/demo_blobs.tif",
      "region": "fixtures/data/empty_region.tif"
    },
    "expect": {
      "status": "FAILED",
      "code": "empty_region",
      "message_contains": "empty"
    }
  },
  {
    "tool": "feature_tour",
    "inputs": {
      "image": "fixtures/data/demo_blobs.tif",
      "region": "fixtures/data/wrong_size_region.tif"
    },
    "expect": {
      "status": "FAILED",
      "code": "bad_input",
      "message_contains": "size of the image"
    }
  },
  {
    "tool": "look_inside_file",
    "inputs": {
      "file": "fixtures/data/settings.json"
    },
    "comment": "a JSON file: its keys and plain values",
    "expect": {
      "results": {
        "values": {
          "kind": "json",
          "keys": "channels, name, normalise, threshold",
          "value_name": "demo",
          "value_threshold": 0.5,
          "value_channels": 3,
          "value_normalise": true
        }
      }
    }
  },
  {
    "tool": "look_inside_file",
    "inputs": {
      "file": "fixtures/data/notes.txt"
    },
    "comment": "any other text: its number of lines",
    "expect": {
      "results": {
        "values": {
          "kind": "text",
          "lines": 3
        }
      }
    }
  },
  {
    "tool": "look_inside_file",
    "inputs": {
      "file": "fixtures/data/square_a.tif"
    },
    "comment": "a binary file is refused, not shown as garbage",
    "expect": {
      "status": "FAILED",
      "code": "not_text",
      "message_contains": "square_a.tif"
    }
  },
  {
    "tool": "summarise_table",
    "inputs": {
      "table": "fixtures/data/measurements.csv"
    },
    "comment": "known answer: length 10,20,30 and width 2,4,6; the id column counts as numbers, the group column does not",
    "expect": {
      "results": {
        "summary": {
          "columns": [
            "column",
            "count",
            "mean",
            "min",
            "max"
          ],
          "rows": 3,
          "cells": {
            "mean[1]": 20.0,
            "max[1]": 30.0,
            "mean[2]": 4.0,
            "min[2]": 2.0
          }
        },
        "values": {
          "rows": 3,
          "columns": 4,
          "numeric_columns": 3
        }
      }
    }
  },
  {
    "tool": "count_above_level",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "mode": "fixed",
      "level": 100
    },
    "comment": "known answer: a 4 x 4 square of 255 in a 32 x 32 image",
    "expect": {
      "results": {
        "values": {
          "pixels": 16,
          "level_used": 100.0
        }
      }
    }
  },
  {
    "tool": "count_above_level",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "mode": "percentile",
      "percentile": 99
    },
    "comment": "the 99th percentile of the pixel values is 255 (16 of 1024 pixels are 255)",
    "expect": {
      "results": {
        "values": {
          "pixels": 16,
          "level_used": 255.0
        }
      }
    }
  },
  {
    "tool": "count_above_level",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "mode": "percentile",
      "percentile": 99,
      "level": 999
    },
    "comment": "a parameter that is greyed out in a host is still accepted: the level is ignored in percentile mode",
    "expect": {
      "results": {
        "values": {
          "pixels": 16
        }
      }
    }
  },
  {
    "tool": "bright_area",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "pixel_size": 0.5
    },
    "comment": "known answer: 16 bright pixels of 0.5 um = 4 um2",
    "expect": {
      "results": {
        "values": {
          "bright_pixels": 16,
          "area_um2": 4.0
        }
      }
    }
  },
  {
    "tool": "bright_area",
    "inputs": {
      "image": "fixtures/data/square_a.tif"
    },
    "comment": "no pixel size: the run is refused, there is no default stand-in",
    "expect": {
      "status": "FAILED",
      "code": "pixel_size_unknown",
      "message_contains": "pixel size"
    }
  },
  {
    "tool": "bright_area",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "pixel_size": 0
    },
    "comment": "a pixel size of 0 is refused",
    "expect": {
      "status": "FAILED",
      "code": "invalid_pixel_size"
    }
  },
  {
    "tool": "align_centres",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "reference": "fixtures/data/square_b.tif"
    },
    "comment": "known answer: the squares' centres are (5.5, 9.5) and (15.5, 21.5): a translation by (10, 12)",
    "expect": {
      "results": {
        "alignment": {
          "matrix": [
            [
              1,
              0,
              10
            ],
            [
              0,
              1,
              12
            ],
            [
              0,
              0,
              1
            ]
          ]
        }
      }
    }
  },
  {
    "tool": "align_centres",
    "inputs": {
      "image": "fixtures/data/square_a.tif",
      "reference": "fixtures/data/square_a.tif"
    },
    "comment": "an image onto itself: the identity",
    "expect": {
      "results": {
        "alignment": {
          "matrix": [
            [
              1,
              0,
              0
            ],
            [
              0,
              1,
              0
            ],
            [
              0,
              0,
              1
            ]
          ]
        }
      }
    }
  }
]
